# backend 설정. 복사해서 backend/.env 로 쓴다 (git에는 올리지 않는다).
# 로컬 SQLite 파일. 배포 시 Turso 주소(libsql://...)로 바꾼다 (ADR-0005).
DATABASE_URL=file:./data/todo-zone.db
# 내 컴퓨터에서만 접속 가능하게 한다 (ADR-0002). 바꾸지 않는다.
HOST=127.0.0.1
PORT=3000

# Vercel 개인용 배포: VITE_ 접두사 없이 서버 환경 변수에만 등록한다.
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=
# AUTH_ENABLED=true
# AUTH_PASSWORD_HASH= (npm run auth:setup -w backend로 생성)
# AUTH_SESSION_SECRET= (동일 명령으로 생성)
